   2,
   3,
   4,
   5,
   6,
   7
  ],
  "seed_scope": "seeds set the Poisson event trains only; the network is deterministic",
  "poisson_rng": "numpy default_rng([seed, round(10*rate_hz), n_activated_cells]); silencing conditions therefore receive exactly the same input trains as their unsilenced pair",
