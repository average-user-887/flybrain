  "duration_ms": 1000.0,
  "initial_state": "rest (-52 mV), all transients zero, reset before every run",
  "activation": "independent Bernoulli-per-0.1 ms-tick Poisson events per activated cell at rate_hz; each event = one tick of pulse_drive (forces a spike unless refractory), equivalent in effect to Shiu 2024 Poisson synapse 250 x W_syn",
