{
  "schema": "neurofly-asset-manifest/1",
  "note": "Presentation assets for web/asset_gallery.html only. Appearance, never simulation: nothing listed here changes physics, stimuli, encoders, the brain or recordings. Files under assets/hq/ are git-ignored and staged by tools/assets/build_all.sh --stage.",
  "units": {
    "name": "viewport-mm",
    "note": "1 unit = 1 viewport-mm. The fly is drawn about 8.3 units long, roughly 3x life size (illustrative scale shared with the dashboard 3D viewport). Not a measurement scale."
  },
  "floor_y": -0.02,
  "layer_sets": {
    "fly": [
      {
        "id": "body",
        "label": "Body (thorax, scutum, head, abdomen, proboscis)",
        "match": [
          "^c_thorax$",
          "^c_scutum$",
          "^c_head$",
          "^c_abdomen\\d+$",
          "^c_proboscis$"
        ]
      },
      {
        "id": "eyes",
        "label": "Compound eyes (flat-shaded style, not ommatidia)",
        "match": [
          "^[lr]_eye$"
        ]
      },
      {
        "id": "antennae",
        "label": "Antennae (rig v1: static)",
        "match": [
          "^[lr]_(pedicel|funiculus|arista)$"
        ]
      },
      {
        "id": "wings",
        "label": "Wings + veins (rig v1: static, not simulated)",
        "match": [
          "^[lr]_wing(_veins)?$"
        ]
      },
      {
        "id": "halteres",
        "label": "Halteres (rig v1: static, not simulated)",
        "match": [
          "^[lr]_haltere$"
        ]
      },
      {
        "id": "bristles",
        "label": "Bristles (static)",
        "match": [
          "_bristles$"
        ]
      },
      {
        "id": "legs",
        "label": "Legs (display pose)",
        "match": [
          "^(lf|lm|lh|rf|rm|rh)_(coxa|trochanterfemur|tibia|tarsus)$"
        ]
      }
    ],
    "shell": [
      {
        "id": "shell",
        "label": "Arena shell plinth (below floor; not a wall, cue or scale)",
        "match": [
          "^shell_(rect|round)$"
        ]
      }
    ],
    "fly_v2": [
      {
        "id": "body",
        "label": "Body (thorax, scutum, head, abdomen, proboscis)",
        "match": [
          "^c_thorax$",
          "^c_scutum$",
          "^c_head$",
          "^c_abdomen\\d+$",
          "^c_proboscis$"
        ]
      },
      {
        "id": "eyes",
        "label": "Compound eyes (flat-shaded style, not ommatidia)",
        "match": [
          "^[lr]_eye$"
        ]
      },
      {
        "id": "antennae",
        "label": "Antennae (presentation joints: animated, not simulated)",
        "match": [
          "^[lr]_(pedicel|funiculus|arista)$"
        ]
      },
      {
        "id": "wings",
        "label": "Wings + veins (presentation joints: animated, not simulated)",
        "match": [
          "^[lr]_wing(_veins)?$"
        ]
      },
      {
        "id": "halteres",
        "label": "Halteres (presentation joints: animated, not simulated)",
        "match": [
          "^[lr]_haltere$"
        ]
      },
      {
        "id": "bristles",
        "label": "Bristles (static)",
        "match": [
          "_bristles$"
        ]
      },
      {
        "id": "legs",
        "label": "Legs (display pose)",
        "match": [
          "^(lf|lm|lh|rf|rm|rh)_(coxa|trochanterfemur|tibia|tarsus)$"
        ]
      }
    ]
  },
